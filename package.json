{
  "name": "@codewrapper/root",
  "root": true,
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crutchcorn/codewrapper.git"
  },
  "bugs": {
    "url": "https://github.com/crutchcorn/codewrapper/issues"
  },
  "homepage": "https://github.com/crutchcorn/codewrapper#readme",
  "scripts": {
    "dev:examples:vanillajs": "turbo run dev --filter @codewrapper/examples-vanillajs",
    "dev:examples:react": "turbo run dev --filter @codewrapper/examples-react",
    "dev:examples:vue": "turbo run dev --filter @codewrapper/examples-vue",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --ignore-unknown . --write",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@typescript-eslint/parser": "^8.41.0",
    "eslint": "^9.34.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.5",
    "prettier": "^3.6.2",
    "turbo": "^1.9.3",
    "typescript-eslint": "^8.41.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">= 99999.0.0",
    "pnpm": ">= 8.0.0"
  },
  "lint-staged": {
    "*{.js,.jsx,.ts,.tsx}": [
      "prettier",
      "eslint --fix"
    ]
  }
}
