{
  "name": "@codewrapper/react",
  "version": "0.0.1",
  "description": "React bindings for building interactive code editors and terminals in the browser.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crutchcorn/codewrapper.git"
  },
  "bugs": {
    "url": "https://github.com/crutchcorn/codewrapper/issues"
  },
  "homepage": "https://github.com/crutchcorn/codewrapper#readme",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\"",
    "lint:package": "publint"
  },
  "devDependencies": {
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.26.1",
    "@codewrapper/config": "workspace:*",
    "@codewrapper/core": "workspace:*",
    "@tanstack/vite-config": "^0.4.3",
    "@types/node": "^18.16.0",
    "@types/react": "^19.1.11",
    "@vitejs/plugin-react": "^5.0.1",
    "@xterm/xterm": "^5.5.0",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "publint": "^0.3.16",
    "typescript": "^5.4.3",
    "vite": "^7.1.3",
    "vite-plugin-dts": "^4.5.4"
  },
  "peerDependencies": {
    "@codemirror/state": ">=6",
    "@codemirror/view": ">=6",
    "@xterm/xterm": ">=5.4.0",
    "react": "^16.8 || ^17.0 || ^18.0"
  },
  "types": "dist/esm/index.d.ts",
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@codewrapper/core": "0.0.1",
    "@tanstack/react-query": "^5.29.2",
    "@tanstack/react-store": "^0.7.4",
    "@tanstack/store": "^0.7.4",
    "@webcontainer/api": "^1.1.9"
  }
}
